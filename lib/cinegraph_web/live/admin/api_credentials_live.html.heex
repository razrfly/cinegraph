<div class="isolate mx-auto max-w-6xl space-y-10 antialiased">
  <header class="space-y-2">
    <h1 class="text-balance text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white">
      API credentials
    </h1>
    <p class="max-w-prose text-pretty text-base text-zinc-600 sm:text-sm dark:text-zinc-400">
      Give each application and environment its own access to the movie catalog.
    </p>
  </header>

  <section
    :if={@issued}
    id="issued-key-panel"
    aria-labelledby="issued-key-heading"
    class="space-y-4 rounded-lg border border-emerald-600/30 bg-emerald-50 p-5 dark:border-white/15 dark:bg-zinc-900"
  >
    <h2
      id="issued-key-heading"
      class="text-balance text-lg font-semibold text-zinc-950 dark:text-white"
    >
      Your new key is ready
    </h2>
    <p class="text-pretty text-base text-zinc-700 sm:text-sm dark:text-zinc-300">
      Copy it now and save it in the application's secret settings. It cannot be retrieved later. This display clears after two minutes or when you leave this page.
    </p>
    <label for="issued-api-key" class="text-sm font-medium text-zinc-900 dark:text-white">
      API key
    </label>
    <input
      id="issued-api-key"
      name="issued_api_key"
      type="text"
      readonly
      value={@issued.token}
      autocomplete="off"
      spellcheck="false"
      class="w-full rounded-md border-zinc-950/15 bg-white font-mono text-base sm:text-sm dark:border-white/15 dark:bg-zinc-950 dark:text-white"
    />
    <div class="flex flex-wrap gap-3 text-sm">
      <button
        id="copy-api-key"
        type="button"
        phx-hook="CopyApiKey"
        class="rounded-md bg-emerald-600 px-3 py-2 font-medium text-white hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
      >
        Copy key
      </button>
      <button
        id="dismiss-api-key"
        type="button"
        phx-click="dismiss_key"
        class="rounded-md px-3 py-2 font-medium text-zinc-700 hover:bg-zinc-950/5 dark:text-zinc-200 dark:hover:bg-white/5"
      >
        I've saved it — hide key
      </button>
    </div>
    <p class="text-pretty text-base text-zinc-600 sm:text-sm dark:text-zinc-400">
      For rotation, keep the previous key active until the application is using this one successfully.
    </p>
  </section>

  <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
    <aside class="min-w-0 space-y-6">
      <section class="space-y-3" aria-labelledby="clients-heading">
        <h2
          id="clients-heading"
          class="text-balance text-lg font-semibold text-zinc-950 dark:text-white"
        >
          Applications
        </h2>
        <p :if={@clients == []} class="text-base text-zinc-600 sm:text-sm dark:text-zinc-400">
          Create your first client below to get started.
        </p>
        <ul role="list" class="space-y-1">
          <li :for={client <- @clients}>
            <.link
              patch={~p"/admin/api-credentials?client=#{client.slug}"}
              id={"client-#{client.slug}"}
              class={[
                "flex items-center justify-between gap-3 rounded-md px-3 py-3 text-base sm:text-sm hover:bg-zinc-950/5 dark:hover:bg-white/5",
                if(@client && @client.id == client.id,
                  do: "bg-zinc-950/5 text-zinc-950 dark:bg-white/10 dark:text-white",
                  else: "text-zinc-600 dark:text-zinc-400"
                )
              ]}
            >
              <div class="min-w-0">
                <p class="truncate font-medium">{client.label}</p>
                <p class="truncate">{client.environment}</p>
              </div>
              <span :if={!client.enabled} class="shrink-0">Disabled</span>
            </.link>
          </li>
        </ul>
      </section>

      <details
        id="new-client-details"
        open={@clients == []}
        class="border-t border-zinc-950/10 pt-5 dark:border-white/10"
      >
        <summary class="cursor-pointer text-base font-medium text-zinc-950 sm:text-sm dark:text-white">
          Add an application
        </summary>
        <.form
          for={@client_form}
          id="create-client-form"
          phx-submit="create_client"
          class="mt-5 space-y-4"
        >
          <.input
            field={@client_form[:label]}
            label="Application name"
            placeholder="Wordhoard preview"
            required
          />
          <.input
            field={@client_form[:slug]}
            label="Client identifier"
            placeholder="wordhoard-preview"
            pattern="[a-z0-9]+(-[a-z0-9]+)*"
            required
          />
          <.input
            field={@client_form[:environment]}
            label="Environment"
            type="select"
            options={[
              {"Preview", "preview"},
              {"Production", "production"},
              {"Development", "development"},
              {"Staging", "staging"}
            ]}
            prompt="Choose an environment"
            required
          />
          <.input
            field={@client_form[:owner_contact]}
            label="Owner contact"
            placeholder="Name or email"
            required
          />
          <button
            type="submit"
            phx-disable-with="Creating…"
            class="rounded-md border border-zinc-950/15 px-3 py-2 text-sm font-medium text-zinc-900 hover:bg-zinc-950/5 dark:border-white/15 dark:text-white dark:hover:bg-white/5"
          >
            Create client
          </button>
        </.form>
      </details>
    </aside>

    <section class="min-w-0 space-y-8" aria-label="Selected application">
      <div :if={!@client} class="space-y-2 border-t border-zinc-950/10 py-8 dark:border-white/10">
        <h2 class="text-balance text-lg font-semibold text-zinc-950 dark:text-white">
          Select an application
        </h2>
        <p class="max-w-prose text-pretty text-base text-zinc-600 sm:text-sm dark:text-zinc-400">
          Choose a client to issue keys and manage access. Use separate clients for preview and production so each can be revoked independently.
        </p>
      </div>

      <div :if={@client} class="space-y-8">
        <div class="space-y-2">
          <h2 class="text-balance text-xl font-semibold text-zinc-950 dark:text-white">
            {@client.label}
          </h2>
          <p class="break-words text-base text-zinc-600 sm:text-sm dark:text-zinc-400">
            {@client.environment} · {@client.owner_contact}
          </p>
          <p class="text-base text-zinc-600 sm:text-sm dark:text-zinc-400">
            Read-only catalog access · {if @client.enabled, do: "Enabled", else: "Disabled"}
          </p>
        </div>

        <section
          :if={@client.enabled}
          aria-labelledby="issue-heading"
          class="space-y-4 border-t border-zinc-950/10 pt-6 dark:border-white/10"
        >
          <h3
            id="issue-heading"
            class="text-balance text-lg font-semibold text-zinc-950 dark:text-white"
          >
            Issue a key
          </h3>
          <p class="text-pretty text-base text-zinc-600 sm:text-sm dark:text-zinc-400">
            New keys work alongside existing keys. Issued by {@operator}.
          </p>
          <.form for={@key_form} id="issue-key-form" phx-submit="issue_key" class="space-y-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <.input
                field={@key_form[:label]}
                label="Key label"
                placeholder="Initial setup"
                required
              />
              <.input
                field={@key_form[:expiry]}
                type="select"
                label="Expires after"
                prompt="Choose an expiry"
                options={[{"90 days", "90"}, {"1 year", "365"}, {"No expiry", "never"}]}
                required
              />
            </div>
            <button
              id="issue-key-button"
              type="submit"
              disabled={@issued != nil}
              phx-disable-with="Issuing…"
              class="rounded-md bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:opacity-50"
            >
              Issue key
            </button>
          </.form>
        </section>

        <section aria-labelledby="keys-heading" class="space-y-4">
          <h3
            id="keys-heading"
            class="text-balance text-lg font-semibold text-zinc-950 dark:text-white"
          >
            Keys
          </h3>
          <p :if={@keys == []} class="text-base text-zinc-600 sm:text-sm dark:text-zinc-400">
            No keys issued yet.
          </p>
          <ul role="list" class="divide-y divide-zinc-950/10 dark:divide-white/10">
            <li
              :for={key <- @keys}
              id={"key-#{key.public_id}"}
              class="flex flex-wrap items-center justify-between gap-4 py-4 first:pt-0 last:pb-0"
            >
              <div class="min-w-0 space-y-1 text-base sm:text-sm">
                <p class="font-medium text-zinc-950 dark:text-white">
                  {key.label} · {key_status(key)}
                </p>
                <p class="break-all font-mono text-zinc-500 dark:text-zinc-400">
                  {key.public_id}
                </p>
                <p class="tabular-nums text-zinc-600 dark:text-zinc-400">
                  Issued {date(key.inserted_at)} · {if key.expires_at,
                    do: "Expires " <> date(key.expires_at),
                    else: "No expiry"}
                </p>
              </div>
              <button
                :if={!key.revoked_at}
                type="button"
                phx-click="revoke_key"
                phx-value-id={key.public_id}
                data-confirm="Revoke this key? Applications still using it will lose access immediately."
                class="shrink-0 rounded-md px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-500/10 dark:text-red-400"
              >
                Revoke
              </button>
            </li>
          </ul>
        </section>

        <section
          :if={@client.enabled}
          class="space-y-3 border-t border-zinc-950/10 pt-6 dark:border-white/10"
        >
          <h3 class="text-balance text-base font-medium text-zinc-950 dark:text-white">
            Disable this application
          </h3>
          <p class="text-pretty text-base text-zinc-600 sm:text-sm dark:text-zinc-400">
            Stops access for every key belonging to this client. Other applications are unaffected.
          </p>
          <button
            id="disable-client"
            type="button"
            phx-click="disable_client"
            data-confirm="Disable this application and deny all of its keys?"
            class="rounded-md border border-red-600/20 px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-500/10 dark:text-red-400"
          >
            Disable client
          </button>
        </section>
      </div>
    </section>
  </div>
</div>
